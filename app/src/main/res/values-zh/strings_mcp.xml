    <!-- Long click descriptions. -->
    <string name="description_mcp_server_enabled">启动本地 MCP (Model Context Protocol) 服务, 使 Claude Desktop, Cursor 等 AI 客户端能够通过无障碍, 脚本引擎与 Shell 能力操控本机.</string>
    <string name="description_mcp_server_enabled_more">服务默认只监听 127.0.0.1, 并自动生成随机访问令牌, 每个请求都必须携带该令牌.</string>
    <string name="description_mcp_server_bind_lan">开启后服务将监听所有网络接口, 同一网络下的其他设备即可访问. 请仅在可信网络中开启.</string>
    <string name="description_mcp_server_port">端口范围 1024 至 65535, 修改后需重启服务生效.</string>

    <!-- Dialogs. -->
    <string name="dialog_mcp_server_risk_title">安全提示</string>
    <string name="dialog_mcp_server_risk_message">启用 MCP 服务会开放一个网络端口, 使已连接的 AI 客户端能够点击屏幕, 读取页面节点树, 执行脚本以及截屏.\n\n服务仅监听 127.0.0.1 且强制校验访问令牌. 请勿在不受你控制的网络中开启局域网访问.</string>
    <string name="dialog_mcp_server_token_title">访问令牌</string>
    <string name="dialog_mcp_server_token_message">请在请求头中携带该值:</string>
    <string name="dialog_mcp_server_token_reset">重置令牌</string>
    <string name="dialog_mcp_server_token_reset_confirm">现有客户端将立即失效, 需要重新配置令牌. 是否继续?</string>
    <string name="dialog_mcp_server_port_title">监听端口</string>
    <string name="dialog_mcp_server_port_invalid">端口必须是 1024 至 65535 之间的整数.</string>

    <!-- MCP protocol facing texts. -->
    <string name="text_mcp_server_instructions">通过 AutoJs6 的无障碍服务与脚本引擎操控 Android 设备. 建议先调用 dump_ui_tree 了解当前屏幕, 再用 ui_find 与 ui_action 进行交互. 当没有可查询的视图树时 —— 游戏, 画布, 视频层 —— 改用 find_image 或 ocr_recognize, 而完全不体现在视图树中的内容则用 read_notifications 获取.</string>

    <!-- Foreground service notification. -->
