<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_updates">

        <org.autojs.autojs.ui.settings.ClearUpdatesCheckedStatesPreference
            app:key="@string/key_updates_checked_states_cleared"
            app:layout="@layout/preference_custom"
            app:summary="@string/text_clear_updates_checked_states_description"
            app:title="@string/text_clear_updates_checked_states" />

        <org.autojs.autojs.ui.settings.CheckForUpdatesWithLocalVersionIgnoredPreference
            app:key="@string/key_check_for_updates_while_ignoring_the_local_version"
            app:layout="@layout/preference_custom"
            app:summary="@string/text_check_for_updates_while_ignoring_the_local_version_description"
            app:title="@string/text_check_for_updates_while_ignoring_the_local_version" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

    <!-- MCP server settings. -->
    <!-- @Added by fork author on Sep 16, 2026. -->
    <org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory
        app:layout="@layout/preference_category_custom"
        app:title="@string/text_mcp_server">

        <org.autojs.autojs.ui.settings.McpServerSwitchPreference
            app:key="@string/key_mcp_server_enabled"
            app:layout="@layout/preference_custom"
            app:longClickPrompt="@string/description_mcp_server_enabled"
            app:longClickPromptMore="@string/description_mcp_server_enabled_more"
            app:title="@string/text_mcp_server_enabled" />

        <org.autojs.autojs.ui.settings.McpServerLanSwitchPreference
            android:defaultValue="false"
            app:key="@string/key_mcp_server_bind_lan"
            app:layout="@layout/preference_custom"
            app:longClickPrompt="@string/description_mcp_server_bind_lan"
            app:summary="@string/summary_mcp_server_bind_lan"
            app:title="@string/text_mcp_server_bind_lan" />

        <!-- No key on purpose: this preference keeps its state in Pref itself. -->
        <org.autojs.autojs.ui.settings.McpServerPortPreference
            app:layout="@layout/preference_custom"
            app:longClickPrompt="@string/description_mcp_server_port"
            app:title="@string/text_mcp_server_port" />

        <!-- No key on purpose: the token lives in its own preference entry. -->
        <org.autojs.autojs.ui.settings.McpServerTokenPreference
            app:layout="@layout/preference_custom"
            app:title="@string/text_mcp_server_token" />

        <org.autojs.autojs.theme.preference.ThemeColorSwitchPreference
            android:defaultValue="false"
            app:key="@string/key_mcp_server_expose_dangerous_tools"
            app:layout="@layout/preference_custom"
            app:longClickPrompt="@string/description_mcp_server_expose_dangerous_tools"
            app:summary="@string/summary_mcp_server_expose_dangerous_tools"
            app:title="@string/text_mcp_server_expose_dangerous_tools" />

    </org.autojs.autojs.theme.preference.ThemeColorPreferenceCategory>

</PreferenceScreen>
